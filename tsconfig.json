{
  "compilerOptions": {
    "target": "es2020",
    "lib": [
      "es2020",
      "dom"
    ],
    "strict": true,
    "module": "esnext",
    "jsx": "preserve",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "next/font",
      "node"
    ],
    "allowJs": true,
    "incremental": true,
    "isolatedModules": true
  },
  "include": [
    "*.ts",
    "*.tsx",
    "app/**/*",
    "components/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}
